# ==============================================================================
# ConnectHub - Free Production Deployment Environment Template
# ==============================================================================

# Execution Environment (production, development, test)
NODE_ENV=production

# Server Port (Render dynamically assigns PORT; defaults to 5000 locally)
PORT=5000

# MongoDB Atlas M0 (Free Tier Cluster) Connection String
# 1. Sign up for free at: https://www.mongodb.com/cloud/atlas
# 2. Deploy a free M0 cluster
# 3. Create a database user (e.g. connecthub_user) and whitelist 0.0.0.0/0 (allow from anywhere)
# 4. Copy connection string with database name 'connecthub'
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/connecthub?retryWrites=true&w=majority

# JWT Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters

# CORS & Allowed Origins
# If hosting frontend on Vercel: set to your Vercel URL (e.g., https://connecthub.vercel.app)
# If hosting full-stack on Render: can be left empty or set to *
CORS_ORIGIN=*
FRONTEND_URL=https://connecthub.onrender.com
