# ==============================================================================
# ConnectHub Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Reuses existing database user: codealpha_user
# Database target: connecthub
# Instructions:
# 1. Replace <password> with your actual password for 'codealpha_user'
# 2. Replace <cluster-url> with your MongoDB Atlas cluster host (e.g., cluster0.abcde.mongodb.net)
MONGO_URI=mongodb+srv://codealpha_user:<password>@<cluster-url>/connecthub?retryWrites=true&w=majority

# JWT Authentication Secret (for upcoming auth implementation)
JWT_SECRET=your_jwt_secret_key_change_in_production
