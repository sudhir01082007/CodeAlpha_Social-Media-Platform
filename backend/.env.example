# ==============================================================================
# ConnectHub Backend Environment Configuration
# ==============================================================================

# Server Execution Mode
NODE_ENV=production

# Server Port (Defaults to 5000 or Render PORT)
PORT=5000

# MongoDB Atlas M0 Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/connecthub?retryWrites=true&w=majority

# JWT Authentication Secret (Minimum 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters

# CORS Allowed Origins
CORS_ORIGIN=*
FRONTEND_URL=https://connecthub.onrender.com
